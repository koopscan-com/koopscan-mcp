            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Headline"
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Name"
