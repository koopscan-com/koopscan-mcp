      "type": "string"
    },
    "postcode_used": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Postcode Used"
    },
    "lookback_months": {
      "title": "Lookback Months",
      "type": "integer"
    },
    "items": {
